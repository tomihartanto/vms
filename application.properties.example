spring.application.name=VMS
spring.jackson.time-zone=Asia/Jakarta

# Scheduling
spring.task.scheduling.enabled=false
spring.task.scheduling.timezone=Asia/Jakarta
spring.task.scheduling.pool.size=4

salt=your_salt_value_here
hostUrl=http://localhost:8081/vms
emailProcessSchedule=0 0/2 * * * ?
emailProcessScheduleGsm=0 0/2 * * * ?
emailDownloadSchedule=0/30 * * * * ?
emailLocationSchedule=0 0/5 * * * ?
emailDailySubscriberSchedule=0 1 1 * * ?

# Database
spring.datasource.url=jdbc:mysql://localhost:3306/ofm?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Jakarta
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# MyBatis & Web
logging.level.com.asset.VMS.mapper=TRACE
mybatis.configuration.map-underscore-to-camel-case=true
mybatis.mapper-locations=classpath:mapper/*.xml
mybatis.type-aliases-package=com.asset.VMS.domain
server.servlet.context-path=/vms
server.port=8081
server.address=0.0.0.0

logging.level.org.springframework.session=DEBUG
spring.main.allow-bean-definition-overriding=true

spring.devtools.restart.enabled=true

# Jakarta Mail IMAP timeouts (ms)
mail.imap.connectiontimeout=10000
mail.imap.timeout=20000
mail.imap.writetimeout=10000
